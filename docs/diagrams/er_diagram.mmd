erDiagram
  STATES ||--o{ DISTRICTS : contains
  DISTRICTS ||--o{ DISTRICT_ALIASES : "known as"
  STATES ||--o{ OUTBREAKS : "reported in"
  DISTRICTS |o--o{ OUTBREAKS : "occurs in"
  DISEASES ||--o{ OUTBREAKS : "is of"
  REPORTS ||--o{ OUTBREAKS : lists
  DISTRICTS ||--o{ WEATHER_DAILY : has
  DISTRICTS ||--o{ PREDICTIONS : "scored for"
  MODEL_VERSIONS ||--o{ PREDICTIONS : produces
  DISTRICTS |o--o{ NEWS_SIGNALS : "mentioned in"

  STATES {
    smallint state_id PK
    varchar state_name UK
    char state_code UK
  }
  DISTRICTS {
    int district_id PK
    int census_code UK "Census 2011"
    smallint state_id FK
    varchar district_name
    numeric latitude
    numeric longitude
  }
  DISTRICT_ALIASES {
    int alias_id PK
    int district_id FK
    smallint state_id FK
    varchar alias_name "UK with state"
    varchar reason
  }
  DISEASES {
    smallint disease_id PK
    varchar disease_name UK
  }
  REPORTS {
    int report_id PK
    smallint year "UK with week"
    smallint week_no
    date week_start
    date week_end
    varchar file_name UK
    text source_url
    char file_hash
    int dengue_rows
  }
  OUTBREAKS {
    bigint outbreak_id PK
    varchar outbreak_key UK
    int report_id FK
    int district_id FK "nullable"
    smallint state_id FK
    smallint disease_id FK
    varchar idsp_unique_id
    varchar district_name_raw
    int cases
    int deaths
    date start_date
    date reporting_date
    int report_lag_days
    varchar current_status
    boolean is_suspected
    boolean needs_review
    smallint times_listed
  }
  WEATHER_DAILY {
    int district_id PK,FK
    date obs_date PK
    numeric precip_mm
    numeric temp_mean_c
    numeric temp_min_c
    numeric temp_max_c
    numeric rel_humidity_pct
    varchar data_type "observed or forecast"
    varchar source "nasa_power or open_meteo"
  }
  MODEL_VERSIONS {
    int model_id PK
    varchar algorithm
    varchar train_period
    jsonb test_metrics
    text file_path
    boolean is_active "only one true"
  }
  PREDICTIONS {
    bigint prediction_id PK
    int model_id FK
    int district_id FK
    date target_week_start
    smallint horizon_weeks
    numeric risk_score
    varchar risk_level
    jsonb top_factors
  }
  NEWS_SIGNALS {
    bigint signal_id PK
    int district_id FK "nullable"
    timestamptz published_at
    text headline
    text url UK
    int extracted_cases
    varchar verification_status
  }
