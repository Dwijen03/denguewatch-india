digraph G {
  rankdir=LR; splines=spline; nodesep=0.35; ranksep=0.65; newrank=true;
  graph [fontname="Arial", fontsize=13, pad=0.3];
  node  [fontname="Arial", fontsize=11, shape=box, style="rounded,filled", penwidth=1.2, margin="0.15,0.08"];
  edge  [fontname="Arial", fontsize=9, color="#404040", arrowsize=0.7];

  subgraph cluster_src { label="1. External data sources"; style="rounded,filled"; fillcolor="#FFFBEA"; color="#BF9000";
    idsp [label="IDSP Weekly Outbreak\nReports (NCDC, PDF)\nweekly, ~2-month lag", fillcolor="#FFF2CC", color="#BF9000"];
    dist [label="District master list\n(Census 2011, 640)", fillcolor="#FFF2CC", color="#BF9000"];
    np   [label="NASA POWER API\ndaily weather 2009-now", fillcolor="#FFF2CC", color="#BF9000"];
    om   [label="Open-Meteo API\nlast 10 days +\n16-day forecast", fillcolor="#FFF2CC", color="#BF9000"];
  }

  subgraph cluster_ing { label="2. Ingestion layer (Python)"; style="rounded,filled"; fillcolor="#F2F7FC"; color="#1F4E79";
    dl   [label="Report discoverer\n& downloader", fillcolor="#DAE8FC", color="#1F4E79"];
    pp   [label="PDF parser\n(pdfplumber)", fillcolor="#DAE8FC", color="#1F4E79"];
    cl   [label="Cleaner &\ndistrict name matcher", fillcolor="#DAE8FC", color="#1F4E79"];
    wf   [label="Weather fetcher\n& weekly aggregator", fillcolor="#DAE8FC", color="#1F4E79"];
    sch  [label="Scheduler (APScheduler)\ndaily: weather + risk, news\nweekly: new IDSP reports\nmonthly: retrain if not worse", fillcolor="#EDEDED", color="#595959"];
  }

  db [label="3. PostgreSQL\n\noutbreaks · reports\ndistricts · states\nweather · predictions\nmodel versions\nnews signals\nagent & job logs", shape=cylinder, style=filled, fillcolor="#E1D5E7", color="#9673A6", fontsize=11, height=1.9];

  subgraph cluster_ml { label="4. ML layer (Python)"; style="rounded,filled"; fillcolor="#F4FAF1"; color="#548235";
    fb [label="Feature builder\nlagged weather, season,\noutbreak history", fillcolor="#E2F0D9", color="#548235"];
    tr [label="Model trainer\n(LightGBM, time-based\nvalidation)", fillcolor="#E2F0D9", color="#548235"];
    rp [label="Risk predictor\nnext 4 weeks\n+ SHAP reasons", fillcolor="#E2F0D9", color="#548235"];
  }

  subgraph cluster_app { label="5. Flask application (one Python server)"; style="rounded,filled"; fillcolor="#FDF1F0"; color="#B85450";
    api  [label="REST API\n/api/v1 (19 endpoints)", fillcolor="#F8CECC", color="#B85450"];
    dash [label="Dash dashboard\n5 pages", fillcolor="#F8CECC", color="#B85450"];
  }

  subgraph cluster_ai { label="6. AI agents (optional)"; style="rounded,filled,dashed"; fillcolor="#FAF5FC"; color="#9673A6";
    ask  [label="Ask DengueWatch\nquestion -> checked\nread-only SQL", fillcolor="#EBDEF0", color="#9673A6"];
    news [label="News-signal agent\n(Google News RSS)\nunverified signals", fillcolor="#EBDEF0", color="#9673A6"];
    llm  [label="LLM\nGoogle Gemini\n(back-up: Groq)", shape=component, fillcolor="#EBDEF0", color="#9673A6"];
  }

  subgraph cluster_usr { label="7. Users"; style="rounded,filled"; fillcolor="#F7F7F7"; color="#7F7F7F";
    u1 [label="Surveillance officer\n(browser)", shape=ellipse, fillcolor="#EDEDED", color="#595959"];
    u2 [label="Researcher\n(browser / API)", shape=ellipse, fillcolor="#EDEDED", color="#595959"];
  }

  idsp -> dl -> pp -> cl;
  dist -> cl;
  np -> wf; om -> wf;
  cl -> db [label="outbreaks"];
  wf -> db [label="weather"];
  db -> fb [label="history"];
  fb -> tr;
  tr -> rp [label="model file"];
  rp -> db [label="risk scores", color="#548235", fontcolor="#548235", constraint=false];
  db -> api [label="SQL", dir=both];
  dash -> api [label="HTTP/JSON", dir=back];
  api -> ask [label="/ask", dir=both];
  ask -> llm [dir=both, style=dashed];
  news -> llm [dir=both, style=dashed];
  news -> db [style=dashed, constraint=false, label="signals"];
  dash -> u1; api -> u2;

  {rank=same; rp; api}
  {rank=same; ask; news}
}
