# Copy this file to ".env" and fill in your own values.
# The .env file is ignored by Git, so your password is never uploaded.

# PostgreSQL connection
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://denguewatch:CHANGE_ME@localhost:5432/denguewatch

# Token required for admin endpoints such as POST /api/v1/admin/refresh
ADMIN_TOKEN=change-me-to-a-long-random-string

# Data sources
IDSP_ARCHIVE_URL=https://ncdc.mohfw.gov.in/includes/WeeklyOutbreaks.php
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Automatic updates (Step 10): 1 = run the daily/weekly/monthly jobs while the app is open
ENABLE_SCHEDULER=1

# Flask
FLASK_DEBUG=1
PORT=8050
